# ============================================
# 连续上涨股票扫描器 - 配置文件示例
# ============================================
# 复制为 .env 后按需修改
# ============================================

# 连续上涨天数（核心筛选条件）
# 例如 5 = 连续5天每天收盘价都比前一天高
CONTINUOUS_UP_DAYS=5

# 扫描市场范围：all / sh / sz
SCAN_MARKET=all

# 输出目录
OUTPUT_DIR=./output

# 是否排除 ST 股票（默认排除）
EXCLUDE_ST=true

# 是否排除科创板(688)/创业板(300)
EXCLUDE_KC_CY=false

# 请求延迟秒数（防封禁，越小越快）
REQUEST_DELAY=0.3

# 单股获取超时秒数
FETCH_TIMEOUT=15

# 最大重试次数
MAX_RETRIES=3
